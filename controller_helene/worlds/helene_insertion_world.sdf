<?xml version="1.0" ?>
<!-- Test bench for force-guided screw insertion.
     A 30 x 30 x 5 cm plate (plate_with_hole.stl, make_plate.py) with a 10 mm square hole, placed where the arm can reach it with the
     tool pointing down (the plate of helene_world.sdf is at x = 0.43 m, beyond the reach
     of the arm without extra tool length). Plate top: z = 0.05 m. Hole centre: (0.30, 0.0). -->
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"></plugin>
    <plugin filename="ignition-gazebo-forcetorque-system" name="ignition::gazebo::systems::ForceTorque"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="hole_board">
      <static>true</static>
      <pose>0.30 0.0 0.025 0 0 0</pose>
      <link name="board_link">
        <collision name="col_plate">
          <geometry><mesh><uri>model://controller_helene/worlds/plate_with_hole.stl</uri></mesh></geometry>
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="vis_plate">
          <geometry><mesh><uri>model://controller_helene/worlds/plate_with_hole.stl</uri></mesh></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
