<?xml version="1.0" ?>
<robot name="helene">

    <link name="world" />

    <joint name="world_to_base_link" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry><mesh filename="package://hw_description/meshes/Komponente1.stl" scale="0.001 0.001 0.001" /></geometry>
            <material name="gold"><color rgba="1 0.549 0 1" /></material>
        </visual>
        <collision>
            <geometry><mesh filename="package://hw_description/meshes/Komponente1.stl" scale="0.001 0.001 0.001" /></geometry>
        </collision>
        <inertial>
            <mass value="0.8" />
            <inertia ixx="1e-3" ixy="1e-3" ixz="1e-3" iyy="1e-3" iyz="1e-3" izz="1e-3" />
        </inertial>
    </link>

    <joint name="q1" type="revolute">
        <axis xyz="0 0 1" />
        <limit effort="1000.0" lower="-2.79" upper="2.79" velocity="5" />
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="axis_0" />
    </joint>

    <ros2_control name="HeleneHardware" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="q1">
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="q2">
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="q3">
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="q4">
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="q5">
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="q6">
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find helene_bringup)/config/helene_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>