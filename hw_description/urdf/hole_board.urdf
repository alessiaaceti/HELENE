<?xml version="1.0"?>
<robot name="hole_board">

  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>

    <visual>
      <origin xyz="0 0.15 0.025" rpy="0 0 0"/>
      <geometry><box size="0.4 0.1 0.05"/></geometry>
      <material name="blue"><color rgba="0.2 0.2 0.8 1"/></material>
    </visual>
    <collision name="col_left">
      <origin xyz="0 0.15 0.025" rpy="0 0 0"/>
      <geometry><box size="0.4 0.1 0.05"/></geometry>
    </collision>

    <visual>
      <origin xyz="0 -0.15 0.025" rpy="0 0 0"/>
      <geometry><box size="0.4 0.1 0.05"/></geometry>
    </visual>
    <collision name="col_right">
      <origin xyz="0 -0.15 0.025" rpy="0 0 0"/>
      <geometry><box size="0.4 0.1 0.05"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.15 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.1 0.2 0.05"/></geometry>
    </visual>
    <collision name="col_front">
      <origin xyz="0.15 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.1 0.2 0.05"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.15 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.1 0.2 0.05"/></geometry>
    </visual>
    <collision name="col_back">
      <origin xyz="-0.15 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.1 0.2 0.05"/></geometry>
    </collision>
  </link>

  <gazebo>
    <static>true</static>
  </gazebo>

</robot>