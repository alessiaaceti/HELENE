<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="helene">

  <xacro:property name="d1" value="0.145" /> 
  <xacro:property name="a2" value="0.200" />
  <xacro:property name="d4" value="0.177" /> 
  <xacro:property name="d6" value="0.055" />

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Komponente1.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="q1" type="revolute">
    <parent link="base_link"/><child link="axis_0"/>
    <origin xyz="0 0 ${d1}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.79" upper="2.79" velocity="5.0" />
  </joint>

  <link name="axis_0">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Komponente2.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="q2" type="revolute">
    <parent link="axis_0"/><child link="axis_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-2.79" upper="2.79" velocity="5.0" />
  </joint>

  <link name="axis_1">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Komponente3.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="q3" type="revolute">
    <parent link="axis_1"/><child link="axis_2"/>
    <origin xyz="0 0 ${a2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-2.79" upper="2.79" velocity="5.0" />
  </joint>

  <link name="axis_2">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Komponente4.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="q4" type="revolute">
    <parent link="axis_2"/><child link="axis_3"/>
    <origin xyz="0 0 ${d4}" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="5.0" />
  </joint>

  <link name="axis_3">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Komponente5.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="q5" type="revolute">
    <parent link="axis_3"/><child link="axis_4"/>
    <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="5.0" />
  </joint>

  <link name="axis_4">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Komponente6.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="q6" type="revolute">
    <parent link="axis_4"/><child link="axis_5"/>
    <origin xyz="0 0 ${d6}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-6.28" upper="6.28" velocity="5.0" />
  </joint>

  <link name="axis_5">
    <visual>
      <geometry><mesh filename="package://hw_description/meshes/Flansch.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <ros2_control name="HeleneHardware" type="system">
    <hardware>
      <plugin>controller_helene/HeleneHardwareInterface</plugin>
    </hardware>
    
    <joint name="q1">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="q2">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="q3">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="q4">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="q5">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="q6">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Force-torque sensor at the end-effector -->
    <sensor name="tcp_force_torque_sensor">
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
  </ros2_control>

</robot>